{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "A client managed by the agency.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the client."
        },
        "city": {
          "type": "string",
          "description": "The city of the client."
        },
        "niche": {
          "type": "string",
          "description": "The business niche of the client."
        },
        "businessModels": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Business models (E-commerce, Negócio Local, Infoproduto, Outros)."
        },
        "logo": {
          "type": "string",
          "description": "Base64 or URL of the client logo."
        },
        "platforms": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Traffic platforms used by the client."
        },
        "investmentValue": {
          "type": "number",
          "description": "Monthly investment value."
        },
        "platformInvestments": {
          "type": "object",
          "additionalProperties": { "type": "number" },
          "description": "Investment breakdown per platform."
        },
        "status": {
          "type": "string",
          "enum": ["active", "delinquent", "paused", "inactive"],
          "description": "The status of the client."
        },
        "country": {
          "type": "string",
          "description": "The country of the client."
        },
        "currency": {
          "type": "string",
          "description": "Currency of the investment (BRL, USD, EUR, GBP, etc.)."
        },
        "startDate": {
          "type": "string",
          "format": "date-time",
          "description": "Project start date."
        },
        "endDate": {
          "type": "string",
          "format": "date-time",
          "description": "Project end date (optional)."
        },
        "contractTerm": {
          "type": "number",
          "description": "Contract term in months."
        },
        "commission": {
          "type": "number",
          "description": "Project commission (value or %)."
        },
        "responsibleManagerId": {
          "type": "string",
          "description": "UID of the team member responsible for this client."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the client was added."
        },
        "uid": {
          "type": "string",
          "description": "The user ID who created this client record."
        }
      },
      "required": ["name", "country", "niche", "status", "startDate", "createdAt", "uid"]
    },
    "User": {
      "title": "User",
      "description": "A team member of the agency.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the team member."
        },
        "email": {
          "type": "string",
          "description": "Email of the team member."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user"],
          "description": "Access level."
        },
        "function": {
          "type": "string",
          "description": "Job function (e.g., Gestor de Tráfego)."
        },
        "permissions": {
          "type": "object",
          "description": "Granular permissions for modules.",
          "properties": {
            "modules": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "view": { "type": "boolean" },
                  "create": { "type": "boolean" },
                  "edit": { "type": "boolean" },
                  "delete": { "type": "boolean" }
                }
              }
            }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user was added."
        },
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID."
        }
      },
      "required": ["name", "email", "role", "createdAt", "uid"]
    },
    "History": {
      "title": "History",
      "description": "A summary or message history record for a client.",
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "description": "The ID of the client this history belongs to."
        },
        "mode": {
          "type": "string",
          "enum": ["communication", "account_actions", "group_update", "client_response", "meeting_summary", "sales_analyzer", "ad_copy_generator"],
          "description": "The type of summary generated."
        },
        "content": {
          "type": "string",
          "description": "The generated summary content."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the history was generated."
        },
        "uid": {
          "type": "string",
          "description": "The user ID who owns this history."
        }
      },
      "required": ["clientId", "mode", "content", "createdAt", "uid"]
    },
    "SalesAnalysis": {
      "title": "SalesAnalysis",
      "description": "A record of a WhatsApp sales analysis generated for a client.",
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "description": "The ID of the client this analysis belongs to."
        },
        "niche": {
          "type": "string",
          "description": "The niche of the analysis."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the analysis was generated."
        },
        "uid": {
          "type": "string",
          "description": "The user ID who owns this analysis."
        }
      },
      "required": ["clientId", "niche", "createdAt", "uid"]
    },
    "Task": {
      "title": "Task",
      "description": "A task for a client.",
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "description": "The ID of the client this task belongs to."
        },
        "title": {
          "type": "string",
          "description": "The title of the task."
        },
        "description": {
          "type": "string",
          "description": "The description of the task."
        },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "description": "The deadline of the task."
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "The priority of the task."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "overdue"],
          "description": "The status of the task."
        },
        "recurrence": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["none", "daily", "weekly", "monthly"]
            },
            "days": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "description": "Recurrence settings for the task."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the task was created."
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the task was completed."
        },
        "uid": {
          "type": "string",
          "description": "The user ID who owns this task."
        }
      },
      "required": ["clientId", "title", "deadline", "priority", "status", "createdAt", "uid"]
    }
  },
  "firestore": {
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Collection of clients."
    },
    "/histories/{historyId}": {
      "schema": "History",
      "description": "Collection of history records for clients."
    },
    "/sales_analyses/{analysisId}": {
      "schema": "SalesAnalysis",
      "description": "Collection of sales analysis records for metrics."
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Collection of tasks for clients."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of team members."
    }
  }
}
